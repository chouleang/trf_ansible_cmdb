# --- Terraform local working files ---
# Downloaded providers + module cache - regenerated by `terraform init`
**/.terraform/*

# Local state files - we'll use remote state per environment; local state
# should never be committed even as a fallback (may contain sensitive
# resource attributes in plaintext)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Plan output files (terraform plan -out=tfplan)
*tfplan*

# Local CLI config / override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Secrets ---
# Private key generated by key-pair.tf (local_file) - NEVER commit this
*.pem
*.ppk
*_rsa
*_rsa.pub

# --- Editor / OS junk ---
.DS_Store
.vscode/
.idea/
